FALKORDB_URL=redis://localhost:6379
FALKORDB_GRAPH=blackbox
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
# Agent ("Live model" in the UI): any OpenRouter key; free models work (50 requests/day).
# Without a key the UI still runs: Scripted and Recorded modes need no model.
OPENROUTER_API_KEY=
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# LLM_FALLBACKS=nvidia/nemotron-3.5-lightning:free,poolside/laguna-s-2.1:free
# Optional keep/drop judge in the CLI flows (packages/agent/src/llm.ts):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
NEXT_PUBLIC_API_URL=http://localhost:3001
